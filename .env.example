# The app runs with NO configuration. Every value here has a working default.
# Copy to .env only if you want to override something.

# Local Postgres from docker-compose. This exact value is the default.
DATABASE_URL="postgres://watchlist:watchlist@localhost:5432/watchlist"

# --- everything below is OPTIONAL and degrades silently if absent ---

# Second market-data source. Only used to surface disagreements (spec §7).
# NSE tickers mostly aren't on Finnhub's free tier, so this is expected to
# return null in practice — that's the "one source" path, not a bug.
# FINNHUB_API_KEY=""
